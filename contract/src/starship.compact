// Starship Leaderboard Contract
//
// On-chain leaderboard for the Midnight Starship game.
// Demonstrates three key privacy patterns:
//   1. Identity privacy     — player identity is a hash of a secret key, never disclosed
//   2. Private scores       — scores stored as commitment hashes, actual values off-chain
//   3. Selective disclosure  — prove_elite proves "my score >= X" via ZK proof
//   4. Voluntary reveal     — reveal_score lets a player optionally publish their score

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ── Ledger state ──

export ledger scoreCommitments: Map<Bytes<32>, Bytes<32>>;   // playerHash → hash(ph, score)
export ledger revealedScores: Map<Bytes<32>, Uint<64>>;      // playerHash → score (voluntary)
export ledger aliases: Map<Bytes<32>, Opaque<"string">>;     // playerHash → display name
export ledger topScore: Uint<64>;                             // highest *revealed* score
export ledger entryCount: Counter;                            // total submissions

// ── Witnesses — private state access ──

witness localSecretKey(): Bytes<32>;
witness storeScore(score: Uint<64>): [];
witness getStoredScore(): Uint<64>;

// ── Pure circuits ──

// Derive a privacy-preserving player identity from a secret key
export circuit playerHash(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "starship:pk:"), sk]);
}

// Compute a binding commitment for a score tied to a player identity
circuit scoreCommitment(ph: Bytes<32>, score: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "starship:sc:"), ph, score as Field as Bytes<32>]);
}

// ── Impure circuits ──

// Submit score — stores commitment on-chain, actual score in private state
export circuit submit_score(score: Uint<64>, alias: Opaque<"string">): [] {
  const sk = localSecretKey();
  const ph = disclose(playerHash(sk));
  const commitment = scoreCommitment(ph, score);
  scoreCommitments.insert(ph, disclose(commitment));
  aliases.insert(ph, disclose(alias));
  storeScore(score);
  entryCount.increment(1);
}

// Selective disclosure — prove score >= threshold via ZK proof
// Score comes from private state; commitment is verified against ledger
export circuit prove_elite(threshold: Uint<64>): [] {
  const sk = localSecretKey();
  const ph = disclose(playerHash(sk));
  assert(scoreCommitments.member(ph), "No score found");
  const my_score = getStoredScore();
  const expected = scoreCommitment(ph, my_score);
  assert(scoreCommitments.lookup(ph) == expected, "Score commitment mismatch");
  assert(my_score >= disclose(threshold), "Below threshold");
}

// Voluntary reveal — disclose actual score publicly
export circuit reveal_score(): [] {
  const sk = localSecretKey();
  const ph = disclose(playerHash(sk));
  assert(scoreCommitments.member(ph), "No score found");
  const my_score = getStoredScore();
  const expected = scoreCommitment(ph, my_score);
  assert(scoreCommitments.lookup(ph) == expected, "Score commitment mismatch");
  const disclosed_score = disclose(my_score);
  revealedScores.insert(ph, disclosed_score);
  if (disclosed_score > topScore) { topScore = disclosed_score; }
}
