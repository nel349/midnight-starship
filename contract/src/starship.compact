// Starship Leaderboard Contract
//
// On-chain leaderboard for the Midnight Starship game.
// Demonstrates three key privacy patterns:
//   1. Identity privacy  — player identity is a hash of a secret key, never disclosed directly
//   2. Public scores     — scores are disclosed so the leaderboard is publicly readable
//   3. Selective disclosure — prove_elite lets a player prove "my score >= X" via ZK proof
//                            without revealing their exact score

pragma language_version >= 0.20;

import CompactStandardLibrary;

// Ledger state — all publicly readable on-chain
export ledger scores: Map<Bytes<32>, Uint<64>>;       // playerHash → score
export ledger aliases: Map<Bytes<32>, Opaque<"string">>; // playerHash → display name
export ledger topScore: Uint<64>;                      // highest score ever submitted
export ledger entryCount: Counter;                     // total submissions

// Witness — provides the player's secret key from off-chain private state
witness localSecretKey(): Bytes<32>;

// Derive a privacy-preserving player identity from a secret key
export circuit playerHash(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "starship:pk:"), sk]);
}

// Submit score — identity is hashed, score is public
export circuit submit_score(score: Uint<64>, alias: Opaque<"string">): [] {
  const sk = localSecretKey();
  const ph = disclose(playerHash(sk));
  const disclosed_score = disclose(score);
  scores.insert(ph, disclosed_score);
  aliases.insert(ph, disclose(alias));
  entryCount.increment(1);
  if (disclosed_score > topScore) { topScore = disclosed_score; }
}

// Selective disclosure — prove score above threshold without revealing exact score
export circuit prove_elite(threshold: Uint<64>): [] {
  const sk = localSecretKey();
  const ph = disclose(playerHash(sk));
  assert(scores.member(ph), "No score found");
  const my_score = scores.lookup(ph);
  assert(my_score >= disclose(threshold), "Below threshold");
}
