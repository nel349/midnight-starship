// Minimal contract for testing ownPublicKey() ownership during dust sponsorship.
//
// Records the caller's ZswapCoinPublicKey on-chain. If dust sponsorship
// works correctly, this value matches the app wallet (proof generator),
// NOT the sponsor wallet (dust payer).
//
// Note: local_nonce() witness exists only to satisfy the SDK's private state
// requirement. The circuit doesn't use its value — ownPublicKey() is built-in.

import CompactStandardLibrary;

export ledger recorded_caller: ZswapCoinPublicKey;

witness local_nonce(): Bytes<32>;

export circuit record_caller(): [] {
  local_nonce();
  recorded_caller = ownPublicKey();
}
